{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the k3s target version in system-upgrade Plans (spec.version) alongside the rancher/k3s-upgrade image tag",
      "managerFilePatterns": [
        "/^system-upgrade/plans\\.yaml$/"
      ],
      "matchStrings": [
        "version: v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\+k3s[0-9]+"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)\\+k3s[0-9]+$"
    }
  ],
  "packageRules": [
    {
      "description": "Ignore fluxcd system updates",
      "enabled": false,
      "matchPackageNames": [
        "/^ghcr.io/fluxcd/"
      ]
    },
    {
      "description": "k3s: patch releases only. Plan.spec.version drives the upgrade, so the image tag and the version must be bumped in the same PR",
      "matchPackageNames": [
        "k3s-io/k3s",
        "rancher/k3s-upgrade"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "description": "k3s: keep image tag and Plan target version in one reviewable PR",
      "matchPackageNames": [
        "k3s-io/k3s",
        "rancher/k3s-upgrade"
      ],
      "groupName": "k3s",
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "ignoreTests": true,
      "automerge": true
    }
  ]
}
